APP_PORT=8080
# Required: replace with a long random password before starting Compose.
POSTGRES_PASSWORD=
# Set true when using HTTPS (e.g. Cloudflare Tunnel).
COOKIE_SECURE=false
# Optional: registry.conraddesign.uk/ielts/ielts-flashcards:<tag>
APP_IMAGE=ielts-flashcards:latest
# Local development only. Use a URL-encoded password in the connection URI.
DATABASE_URL=postgresql://flashcards:CHANGE_ME@localhost:5432/flashcards
